{
  "name": "okapi-learn",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "generate:session-secret": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64url'))\"",
    "lint": "eslint .",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e:functional": "npm run build && PLAYWRIGHT_SUITE=functional playwright test --grep-invert @visual",
    "test:e2e:visual": "npm run build && PLAYWRIGHT_SUITE=visual playwright test --grep @visual --project=chromium --project=mobile-chromium",
    "test:e2e:visual:update": "npm run build && PLAYWRIGHT_SUITE=visual playwright test --grep @visual --project=chromium --project=mobile-chromium --update-snapshots=all",
    "check:dependencies": "npm ls --all",
    "check:licenses": "node tools/check-licenses.mjs",
    "scan:secrets": "node tools/scan-secrets.mjs",
    "scan:personal-data": "node tools/scan-personal-data.mjs",
    "scan:diagnostics": "node tools/scan-diagnostics.mjs diagnostics test-results-visual",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@upstash/redis": "^1.38.4",
    "@zip.js/zip.js": "2.14.1",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "happy-dom": "20.14.5",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vitest": "5.0.1"
  }
}
