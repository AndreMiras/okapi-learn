# Server-only application configuration. All values below are fictional.
NEXT_TELEMETRY_DISABLED=1
# Optional. Defaults to https://api.kidsandus.es
# MYLOCKER_API_BASE_URL=https://api.kidsandus.es
# Generate with: npm run generate:session-secret
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_TTL_SECONDS=28800
# Must exactly match the browser origin. Use http://localhost:3000 for local development.
PUBLIC_APP_ORIGIN=https://learn.okapi.example
# Required on Vercel. Added automatically by the Upstash Redis integration.
# KV_REST_API_URL=https://example.upstash.io
# KV_REST_API_TOKEN=replace-with-upstash-rest-token
ENABLE_VIDEO_PLAYBACK=false
ENABLE_AUDIO_PLAYBACK=false
ENABLE_GAME_PLAYBACK=false
# Exact HTTPS origins only: no paths, wildcards, credentials, fragments, or custom ports.
# Audio and video require separate approval. Keep both lists empty while disabled.
ALLOWED_VIDEO_ORIGINS=
ALLOWED_AUDIO_ORIGINS=
# Exact package redirect origins only. Complete the operator's accepted-risk
# review and configure host-level rate, concurrency, timeout, and memory controls.
# Keep empty while games are disabled.
ALLOWED_GAME_ORIGINS=
